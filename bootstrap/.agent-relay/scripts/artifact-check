#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RELAY_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$RELAY_DIR/.." && pwd)

die() {
  printf 'artifact-check: %s\n' "$*" >&2
  exit 1
}

require_line() {
  pattern="$1"
  message="$2"
  LC_ALL=C grep -Eq "$pattern" "$artifact" || die "$event artifact $message: $path"
}

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || \
  die "usage: artifact-check <PLANNED|EXECUTED|REVIEW|CLOSE> <path> [task-id]"

event="$1"
path="$2"
expected_task_id="${3:-}"

case "$event" in
  PLANNED|EXECUTED|REVIEW|CLOSE) ;;
  *) die "unsupported event: $event" ;;
esac

case "$path" in
  .agent-relay/runs/*) ;;
  *) die "$event path must be under .agent-relay/runs/: $path" ;;
esac
case "$path" in
  *..*|*[!A-Za-z0-9._/-]*) die "$event path contains unsupported characters: $path" ;;
esac

case "$event:$path" in
  PLANNED:.agent-relay/runs/*-PLAN.md|\
  EXECUTED:.agent-relay/runs/*-RUN-[0-9][0-9].md|\
  REVIEW:.agent-relay/runs/*-REVIEW-[0-9][0-9].md|\
  CLOSE:.agent-relay/runs/*-CLOSE.md)
    ;;
  *) die "$event artifact name does not match its event: $path" ;;
esac

artifact="$PROJECT_DIR/$path"
[ -f "$artifact" ] || die "$event path not found: $path"

if LC_ALL=C grep -Eq '<[^<>]+>' "$artifact"; then
  die "$event artifact contains an unresolved placeholder: $path"
fi
if [ "$event" = "EXECUTED" ] && LC_ALL=C grep -Eq 'TODO' "$artifact"; then
  die "$event artifact contains an unresolved TODO: $path"
fi

require_line '^Task ID:[[:space:]]*[^[:space:]].*' "must include Task ID"
if [ -n "$expected_task_id" ] && ! LC_ALL=C grep -Fqx "Task ID: $expected_task_id" "$artifact"; then
  die "$event artifact Task ID does not match $expected_task_id: $path"
fi
require_line '^Date:[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]*$' \
  "must include an ISO date"

case "$event" in
  PLANNED)
    require_line '^# PLAN: .+' "must have a PLAN title"
    require_line '^Planner:[[:space:]]*[^[:space:]].*' "must identify the Planner"
    require_line '^## Director Brief[[:space:]]*$' "must include Director Brief"
    require_line '^## Success Criteria[[:space:]]*$' "must include Success Criteria"
    require_line '^## Validation[[:space:]]*$' "must include Validation"
    ;;
  EXECUTED)
    round=${path##*-RUN-}
    round=${round%.md}
    require_line "^# RUN-$round: .+" "title must match RUN-$round"
    require_line '^Executor:[[:space:]]*[^[:space:]].*' "must identify the Executor"
    require_line '^Status:[[:space:]]*complete[[:space:]]*$' "must set Status: complete"
    require_line '^## Validation[[:space:]]*$' "must include Validation"
    require_line '^## Success Criteria Status[[:space:]]*$' "must include Success Criteria Status"
    ;;
  REVIEW)
    round=${path##*-REVIEW-}
    round=${round%.md}
    require_line "^# REVIEW-$round: .+" "title must match REVIEW-$round"
    require_line '^Planner:[[:space:]]*[^[:space:]].*' "must identify the Planner"
    require_line '^Result:[[:space:]]*(ready-for-user-decision|blockers)[[:space:]]*$' \
      "must set a valid Result"
    require_line '^## Suggested User Checks[[:space:]]*$' "must include Suggested User Checks"
    require_line '^## Evidence Reviewed[[:space:]]*$' "must include Evidence Reviewed"
    ;;
  CLOSE)
    require_line '^# CLOSE: .+' "must have a CLOSE title"
    require_line '^Director:[[:space:]]*[^[:space:]].*' "must identify the Director"
    require_line '^Approved By:[[:space:]]*User[[:space:]]*$' "must record user approval"
    require_line '^## Acceptance[[:space:]]*$' "must include Acceptance"
    require_line '^## Validation Summary[[:space:]]*$' "must include Validation Summary"
    ;;
esac
