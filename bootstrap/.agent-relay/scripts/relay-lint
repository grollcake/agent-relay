#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RELAY_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$RELAY_DIR/.." && pwd)
LOG_FILE="$RELAY_DIR/relay.log"

errors=0

err() {
  errors=$((errors + 1))
  printf 'ERROR: %s\n' "$*" >&2
}

ok() {
  printf 'OK: %s\n' "$*"
}

require_file() {
  [ -f "$1" ] && ok "$1 exists" || err "missing $1"
}

require_dir() {
  [ -d "$1" ] && ok "$1 exists" || err "missing $1"
}

check_agent_blocks() {
  ag="$PROJECT_DIR/AGENTS.md"
  claude="$PROJECT_DIR/CLAUDE.md"
  [ -f "$ag" ] || return 0
  [ -f "$claude" ] || return 0

  ag_block=$(sed -n '/<agent-relay-rules>/,/<\/agent-relay-rules>/p' "$ag")
  claude_block=$(sed -n '/<agent-relay-rules>/,/<\/agent-relay-rules>/p' "$claude")

  if [ -z "$ag_block" ]; then
    err "AGENTS.md missing <agent-relay-rules> block"
  elif [ -z "$claude_block" ]; then
    err "CLAUDE.md missing <agent-relay-rules> block"
  elif [ "$ag_block" != "$claude_block" ]; then
    err "AGENTS.md and CLAUDE.md Agent Relay blocks differ"
  else
    ok "AGENTS.md and CLAUDE.md Agent Relay blocks match"
  fi
}

trim_field() {
  printf '%s\n' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

check_artifacts() {
  [ -f "$LOG_FILE" ] || return 0

  line_number=0
  while IFS='|' read -r timestamp task event role summary path extra; do
    line_number=$((line_number + 1))
    task=$(trim_field "$task")
    event=$(trim_field "$event")
    path=$(trim_field "$path")

    [ -z "$extra" ] || continue
    [ -n "$path" ] || continue

    case "$event" in
      PLANNED|EXECUTED|REVIEW|CLOSE)
        if ! message=$("$RELAY_DIR/scripts/artifact-check" "$event" "$path" "$task" 2>&1); then
          err "relay log line $line_number: $message"
        fi
        ;;
      *)
        [ -f "$PROJECT_DIR/$path" ] || err "artifact path not found on line $line_number: $path"
        ;;
    esac
  done < "$LOG_FILE"
}

check_log() {
  [ -f "$LOG_FILE" ] || return 0
  awk -F'|' '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      return value
    }
    function expected_role(event) {
      if (event == "REQUEST" || event == "FEEDBACK" || event == "CLOSE" || event == "RUN_DONE") return "Director"
      if (event == "PLANNED" || event == "REVIEW") return "Planner"
      if (event == "EXECUTED") return "Executor"
      return ""
    }
    function valid_transition(prior, event) {
      if (prior == "") return event == "REQUEST"
      if (prior == "REQUEST") return event == "PLANNED" || event == "RUN_DONE"
      if (prior == "PLANNED") return event == "EXECUTED"
      if (prior == "EXECUTED") return event == "REVIEW"
      if (prior == "REVIEW") return event == "EXECUTED" || event == "FEEDBACK" || event == "CLOSE"
      if (prior == "FEEDBACK") return event == "EXECUTED"
      return 0
    }
    function artifact_round(path, event, value) {
      value = path
      if (event == "EXECUTED" && value ~ /-RUN-[0-9][0-9]\.md$/) {
        sub(/^.*-RUN-/, "", value)
        sub(/\.md$/, "", value)
        return value
      }
      if (event == "REVIEW" && value ~ /-REVIEW-[0-9][0-9]\.md$/) {
        sub(/^.*-REVIEW-/, "", value)
        sub(/\.md$/, "", value)
        return value
      }
      return ""
    }
    function artifact_key(path, event, value) {
      value = path
      if (event == "PLANNED") sub(/-PLAN\.md$/, "", value)
      if (event == "EXECUTED") sub(/-RUN-[0-9][0-9]\.md$/, "", value)
      if (event == "REVIEW") sub(/-REVIEW-[0-9][0-9]\.md$/, "", value)
      if (event == "CLOSE") sub(/-CLOSE\.md$/, "", value)
      return value
    }
    NF < 4 || NF > 6 {
      if (trim($0) != "") {
        print "ERROR: malformed relay log line " NR
        bad = 1
      }
      next
    }
    NF >= 4 {
      task = trim($2)
      event = trim($3)
      role = trim($4)
      expected = expected_role(event)
      path = NF >= 6 ? trim($6) : ""

      if (task == "") {
        print "ERROR: missing task-id on line " NR
        bad = 1
      }
      if (expected == "") {
        print "ERROR: invalid event on line " NR ": " event
        bad = 1
      } else if (role != expected) {
        print "ERROR: invalid role on line " NR ": " event " requires " expected ", got " role
        bad = 1
      }

      if (task != "" && expected != "") {
        prior = last_event[task]
        if (!valid_transition(prior, event)) {
          shown_prior = prior == "" ? "START" : prior
          print "ERROR: invalid transition on line " NR " for task-id " task ": " shown_prior " -> " event
          bad = 1
        }
        last_event[task] = event
      }

      if ((event == "PLANNED" || event == "EXECUTED" || event == "REVIEW" || event == "CLOSE") && path == "") {
        print "ERROR: missing path on line " NR ": " event
        bad = 1
      }
      if (task != "" && event == "PLANNED" && path != "") {
        task_key[task] = artifact_key(path, event)
      }
      if (task != "" && event == "EXECUTED" && path != "") {
        round = artifact_round(path, event)
        key = artifact_key(path, event)
        if (key != task_key[task]) {
          print "ERROR: RUN artifact key does not match PLAN on line " NR " for task-id " task
          bad = 1
        }
        if (round == "") {
          print "ERROR: invalid RUN artifact name on line " NR ": " path
          bad = 1
        } else {
          pending_round[task] = round
          pending_key[task] = artifact_key(path, event)
        }
      }
      if (task != "" && event == "REVIEW" && path != "") {
        round = artifact_round(path, event)
        key = artifact_key(path, event)
        if (round == "") {
          print "ERROR: invalid REVIEW artifact name on line " NR ": " path
          bad = 1
        } else if (!(task in pending_round)) {
          print "ERROR: REVIEW has no corresponding EXECUTED on line " NR " for task-id " task
          bad = 1
        } else {
          if (round != pending_round[task]) {
            print "ERROR: round mismatch on line " NR " for task-id " task ": RUN-" pending_round[task] " -> REVIEW-" round
            bad = 1
          }
          if (key != pending_key[task]) {
            print "ERROR: artifact key mismatch on line " NR " for task-id " task
            bad = 1
          }
          if (key != task_key[task]) {
            print "ERROR: REVIEW artifact key does not match PLAN on line " NR " for task-id " task
            bad = 1
          }
          delete pending_round[task]
          delete pending_key[task]
        }
      }
      if (task != "" && event == "CLOSE" && path != "" && artifact_key(path, event) != task_key[task]) {
        print "ERROR: CLOSE artifact key does not match PLAN on line " NR " for task-id " task
        bad = 1
      }
    }
    END {
      for (task in last_event) {
        task_count++
        if (last_event[task] == "CLOSE" || last_event[task] == "RUN_DONE") closed_count++
        else open_count++
      }
      print "OK: relay tasks: " (task_count + 0) " total, " (closed_count + 0) " closed, " (open_count + 0) " open"
      exit bad ? 1 : 0
    }
  ' "$LOG_FILE" || errors=$((errors + 1))
}

cd "$PROJECT_DIR"

require_file "$RELAY_DIR/PROTOCOL.md"
require_file "$RELAY_DIR/DIRECTOR.md"
require_file "$RELAY_DIR/PLANNER.md"
require_file "$RELAY_DIR/EXECUTOR.md"
require_file "$RELAY_DIR/HOW-TO-UPDATE.md"
require_file "$RELAY_DIR/VERSION"
require_file "$RELAY_DIR/GUIDANCE.md"
require_file "$RELAY_DIR/LESSON-LEARNED.md"
require_file "$LOG_FILE"
require_file "$RELAY_DIR/scripts/director-tool"
require_file "$RELAY_DIR/scripts/artifact-check"
require_dir "$RELAY_DIR/templates"
require_dir "$RELAY_DIR/runs"
require_dir "$RELAY_DIR/lesson-learned"

[ -x "$RELAY_DIR/scripts/director-tool" ] && ok "director-tool is executable" || err "director-tool is not executable"
[ -x "$RELAY_DIR/scripts/artifact-check" ] && ok "artifact-check is executable" || err "artifact-check is not executable"
[ ! -e "$RELAY_DIR/protocol-guard" ] && ok "legacy protocol-guard absent" || err "legacy protocol-guard should be moved to scripts/director-tool"

check_agent_blocks
check_artifacts
check_log

if [ "$errors" -gt 0 ]; then
  printf 'relay-lint failed: %s error(s)\n' "$errors" >&2
  exit 1
fi

printf 'relay-lint passed\n'
